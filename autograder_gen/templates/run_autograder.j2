#!/bin/bash

set -e

AUTOGRADER_ROOT="${AUTOGRADER_ROOT:-/autograder}"
SUBMISSION_DIR="${AUTOGRADER_ROOT}/submission"
SOURCE_DIR="${AUTOGRADER_ROOT}/source"
RESULTS_DIR="${AUTOGRADER_ROOT}/results"
PYTHON="${PYTHON:-python3}"

mkdir -p "$RESULTS_DIR"
export AUTOGRADER_ROOT="${AUTOGRADER_ROOT}"
export GRADESCOPE_RESULTS_PATH="${GRADESCOPE_RESULTS_PATH:-$RESULTS_DIR/results.json}"
export GRADESCOPE_SOURCE_PATH="${GRADESCOPE_SOURCE_PATH:-$SOURCE_DIR}"

FILE_CHECK_LOG="$RESULTS_DIR/file_check.log"
true > "$FILE_CHECK_LOG"

echo "Starting autograder..."
if [ -f "$AUTOGRADER_ROOT/submission_metadata.json" ]; then
    cp "$AUTOGRADER_ROOT/submission_metadata.json" "$SOURCE_DIR/"
elif [ -f "/autograder/submission_metadata.json" ]; then
    cp "/autograder/submission_metadata.json" "$SOURCE_DIR/"
elif [ -d "$SUBMISSION_DIR" ] && [ -f "$SUBMISSION_DIR/submission_metadata.json" ]; then
    cp "$SUBMISSION_DIR/submission_metadata.json" "$SOURCE_DIR/"
elif [ -f "submission_metadata.json" ]; then
    cp "submission_metadata.json" "$SOURCE_DIR/"
fi

{% if retrieve_student_id %}
if [ -f "$SOURCE_DIR/grader_utils.py" ]; then
    STUDENT_ID_OUTPUT=$("$PYTHON" -c '
import sys, json
sys.path.insert(0, sys.argv[1])
from grader_utils import get_student_id
get_student_id(sys.argv[2], excluded_ids=json.loads(sys.argv[3]))
' "$SOURCE_DIR" "$AUTOGRADER_ROOT" '{{ config.excluded_student_ids | tojson }}' 2>&1)
    echo "$STUDENT_ID_OUTPUT" | tee -a "$FILE_CHECK_LOG"
fi
{% endif %}
{% if config.language == 'python' %}
PYTHON_VERSION=$("$PYTHON" --version 2>&1 || echo "Python 3.10")
echo "[INFO] Environment: $PYTHON_VERSION" | tee -a "$FILE_CHECK_LOG"
{% elif config.language == 'java' %}
if command -v java >/dev/null 2>&1; then
    JAVA_VERSION=$(java -version 2>&1 | head -n 1)
    echo "[INFO] Environment: $JAVA_VERSION" | tee -a "$FILE_CHECK_LOG"
elif command -v javac >/dev/null 2>&1; then
    JAVA_VERSION=$(javac -version 2>&1 | head -n 1)
    echo "[INFO] Environment: $JAVA_VERSION" | tee -a "$FILE_CHECK_LOG"
else
    echo "[INFO] Environment: OpenJDK 25" | tee -a "$FILE_CHECK_LOG"
fi
{% endif %}
echo "Copying required submission files to source directory..."

if [ -d "$SUBMISSION_DIR" ]; then
    cd "$SUBMISSION_DIR"
    {% for file in config.required_files %}
    echo "[INFO] Checking required file: {{ file }}..." | tee -a "$FILE_CHECK_LOG"
    if [ -f "{{ file }}" ]; then
        echo "[INFO] File '{{ file }}' exists." | tee -a "$FILE_CHECK_LOG"
        mkdir -p "$SOURCE_DIR/$(dirname "{{ file }}")"
        cp "{{ file }}" "$SOURCE_DIR/{{ file }}"
    else
        echo "[WARNING] Required file {{ file }} not found in submission" | tee -a "$FILE_CHECK_LOG"
        {% if not config.strict_file_location %}
        FOUND_FILE=$(find . -name "$(basename "{{ file }}")" -type f | head -n 1)
        if [ -n "$FOUND_FILE" ]; then
            echo "[INFO] Found file '{{ file }}' at $FOUND_FILE{% if config.wrong_file_location_deduction > 0 %}, penalties will be applied{% endif %}" | tee -a "$FILE_CHECK_LOG"
            TARGET_SUBDIR=$(dirname "$FOUND_FILE" | sed 's|^\./||')
            mkdir -p "$SOURCE_DIR/$TARGET_SUBDIR"
            cp "$FOUND_FILE" "$SOURCE_DIR/$TARGET_SUBDIR/"
        fi
        {% endif %}
    fi
    {% endfor %}
    if [ ! -f "$SOURCE_DIR/submission_metadata.json" ] && [ -f "submission_metadata.json" ]; then
        cp "submission_metadata.json" "$SOURCE_DIR/"
    fi
{% for question in config.questions %}
{% set hidden_count = question.marking_items | selectattr('visibility', 'in', ['after_due_date', 'after_published']) | list | length %}
{% if hidden_count > 0 %}
    echo "[INFO] {{ question.name }}{% if not question.name.endswith(')') %}){% endif %} has {{ hidden_count }} hidden marking item{{ 's' if hidden_count > 1 else '' }}" | tee -a "$FILE_CHECK_LOG"
{% endif %}
{% endfor %}

else
    echo "[WARNING] Submission directory not found" | tee -a "$FILE_CHECK_LOG"
    exit 1
fi

cd "$SOURCE_DIR"
echo "Running tests..."
"$PYTHON" run_tests.py

if [ -f "$GRADESCOPE_RESULTS_PATH" ] && [ -s "$FILE_CHECK_LOG" ]; then
    "$PYTHON" -c "
import json, os
path = os.environ.get('GRADESCOPE_RESULTS_PATH')
log_path = '$FILE_CHECK_LOG'
if path and os.path.exists(path) and os.path.exists(log_path):
    try:
        with open(path, 'r', encoding='utf-8') as f:
            data = json.load(f)
        with open(log_path, 'r', encoding='utf-8') as f:
            log_content = f.read().strip()
        if log_content:
            existing = data.get('output', '')
            data['output'] = (log_content + '\n\n' + existing).strip() if existing else log_content
        with open(path, 'w', encoding='utf-8') as f:
            json.dump(data, f, indent=2)
    except Exception:
        pass
"
fi

echo "Autograder completed successfully"
